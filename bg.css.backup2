/* ==========================================
   MACHINE SEARCH — Background
   ========================================== */

body {
  background: var(--bg);
  background-image: radial-gradient(circle at 50% 0%, rgba(220,38,38,0.06) 0%, transparent 60%);
  background-attachment: fixed;
  color: var(--text-primary);
  min-height: 100vh;
}
