/* ============================================================
   MACHINE SEARCH — Shared App Logic (Repaired v2)
   ============================================================ */

const MS = (() => {
  let _toastTimer;
  function toast(msg, type = '') {
    let el = document.getElementById('ms-toast');
    if (!el) {
      el = document.createElement('div');
      el.id = 'ms-toast';
      el.className = 'toast';
      document.body.appendChild(el);
    }
    el.textContent = msg;
    el.className = 'toast show' + (type ? ' toast--' + type : '');
    clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => { el.className = 'toast' + (type ? ' toast--' + type : ''); }, 1800);
  }

  async function copy(text) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      return true;
    } catch (e) { return false; }
  }

  function normalize(s) {
    return (s || '').toString().toLowerCase().replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
  }

  function tokenize(q) { return normalize(q).split(' ').filter(t => t.length > 0); }

  function search(machines, query) {
    const q = normalize(query);
    if (!q) return [];
    const qTokens = tokenize(query);
    if (qTokens.length === 0) return [];
    const hits = [];
    for (const m of machines) {
      const name = normalize(m.name);
      const code = normalize(m.code);
      const haystack = name + ' ' + code;
      let allMatch = true;
      for (const t of qTokens) { if (!haystack.includes(t)) { allMatch = false; break; } }
      if (!allMatch) continue;
      let score;
      if (code === q) score = 1000;
      else if (name === q) score = 900;
      else if (name.startsWith(q)) score = 800;
      else {
        let ts = 0;
        for (const t of qTokens) {
          if (name.startsWith(t)) ts += 50;
          else if (name.includes(' ' + t)) ts += 30;
          else if (name.includes(t)) ts += 20;
          else if (code.includes(t)) ts += 10;
        }
        score = ts + qTokens.length * 5;
      }
      hits.push({ machine: m, score });
    }
    hits.sort((a, b) => b.score - a.score || (a.machine.no || 0) - (b.machine.no || 0));
    return hits.map(h => h.machine);
  }

  function escapeHtml(s) {
    return (s == null ? '' : String(s)).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function escapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
  function highlight(text, query) {
    const tokens = tokenize(query);
    if (tokens.length === 0) return escapeHtml(text);
    let out = escapeHtml(text);
    const sorted = [...tokens].sort((a, b) => b.length - a.length);
    for (const t of sorted) { out = out.replace(new RegExp('(' + escapeRegex(t) + ')', 'gi'), '<mark>$1</mark>'); }
    return out;
  }

  function parseMachineCode(code) {
    if (!code) return '';
    return String(code).trim()
      .replace(/^[A-Za-z]_/, '')
      .replace(/_\d+$/, '')
      .replace(/_/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  // ---------- STORAGE (unified + migration) ----------
  const STORAGE_KEY = 'ms_data_v2';
  const LEGACY_KEY = 'ms_data_v1';

  function migrateLegacy() {
    try {
      const legacy = localStorage.getItem(LEGACY_KEY);
      if (!legacy) return;
      const current = localStorage.getItem(STORAGE_KEY);
      if (!current) {
        localStorage.setItem(STORAGE_KEY, legacy);
      }
      localStorage.removeItem(LEGACY_KEY);
    } catch (e) { console.warn('migration failed', e); }
  }

  async function loadData() {
    migrateLegacy();
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try { return JSON.parse(saved); } catch (e) { console.warn('parse failed', e); }
    }
    try {
      const res = await fetch('data/machines.json');
      if (res.ok) {
        const data = await res.json();
        saveData(data);
        return data;
      }
    } catch (e) { console.warn('fetch failed', e); }
    return {
      meta: { filename: '—', sheet: '—', location: '—', importedAt: '—', totalRecords: 0 },
      machines: []
    };
  }

  function saveData(data) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      return true;
    } catch (e) { console.error('save failed', e); return false; }
  }

  function clearData() { localStorage.removeItem(STORAGE_KEY); }

  // ---------- HISTORY ----------
  const HISTORY_KEY = 'ms_history_v2';
  function getHistory() {
    try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); }
    catch { return []; }
  }
  function pushHistory(query) {
    if (!query || !query.trim()) return;
    const q = query.trim();
    let hist = getHistory().filter(h => h !== q);
    hist.unshift(q);
    try { localStorage.setItem(HISTORY_KEY, JSON.stringify(hist.slice(0, 50))); } catch (e) {}
  }
  function clearHistory() { localStorage.removeItem(HISTORY_KEY); }
  function removeHistory(q) {
    try { localStorage.setItem(HISTORY_KEY, JSON.stringify(getHistory().filter(h => h !== q))); } catch (e) {}
  }

  // ---------- FAVORITES ----------
  const FAV_KEY = 'ms_favorites_v2';
  function getFavorites() {
    try { return JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); }
    catch { return []; }
  }
  function isFavorite(code) { return getFavorites().some(f => f.code === code); }
  function toggleFavorite(machine) {
    let favs = getFavorites();
    if (favs.some(f => f.code === machine.code)) {
      try { localStorage.setItem(FAV_KEY, JSON.stringify(favs.filter(f => f.code !== machine.code))); } catch (e) {}
      return false;
    }
    favs.unshift({
      code: machine.code,
      name: machine.name,
      location: machine.location,
      number: machine.number,
      savedAt: Date.now()
    });
    try { localStorage.setItem(FAV_KEY, JSON.stringify(favs)); } catch (e) {}
    return true;
  }
  function removeFavorite(code) {
    try { localStorage.setItem(FAV_KEY, JSON.stringify(getFavorites().filter(f => f.code !== code))); } catch (e) {}
  }

  function debounce(fn, ms) {
    let t;
    return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
  }

  const ICON = {
    search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
    close: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>',
    home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>',
    database: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"/><path d="M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/></svg>',
    star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3l2.7 5.7 6.3.9-4.6 4.4 1.1 6.2L12 17.3 6.5 20.2 7.6 14 3 9.6l6.3-.9L12 3z"/></svg>',
    starFilled: '<svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3l2.7 5.7 6.3.9-4.6 4.4 1.1 6.2L12 17.3 6.5 20.2 7.6 14 3 9.6l6.3-.9L12 3z"/></svg>',
    settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 0 1 0 2.8 2 2 0 0 1-2.8 0l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 0 1-2.8 0 2 2 0 0 1 0-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 0 1 0-2.8 2 2 0 0 1 2.8 0l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 0 1 2.8 0 2 2 0 0 1 0 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>',
    back: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>',
    upload: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m0-12l-4 4m4-4l4 4M4 20h16"/></svg>',
    copy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>',
    clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
    info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1" stroke-linecap="round"/></svg>',
    machine: '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="4" width="14" height="18" rx="2"/><rect x="5" y="6" width="10" height="6" rx="1" fill="#14213D"/><circle cx="6.5" cy="17" r="1" fill="#14213D"/><circle cx="10" cy="17" r="1" fill="#14213D"/><circle cx="13.5" cy="17" r="1" fill="#14213D"/></svg>',
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>',
    warning: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L1 21h22L12 2z"/><path d="M12 9v5M12 18h.01"/></svg>',
    edit: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
    refresh: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>',
    tool: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>'
  };

  function header() {
    return '<header class="app-header">' +
      '<a href="index.html" class="app-header__logo" aria-label="Home">' +
        '<img src="assets/logo-nav.svg" alt="" width="40" height="40">' +
      '</a>' +
      '<div class="app-header__title">' +
        '<div class="app-header__name">MACHINE SEARCH</div>' +
        '<div class="app-header__tagline">FIND MACHINES. GET CODES.</div>' +
      '</div>' +
    '</header>';
  }

  function backHeader(title, backHref = 'index.html') {
    return '<header class="back-header">' +
      '<a href="' + backHref + '" class="back-header__back" aria-label="Back">' + ICON.back + '</a>' +
      '<div class="back-header__title">' + escapeHtml(title) + '</div>' +
    '</header>';
  }

  function bottomNav(active) {
    const items = [
      { href: 'index.html',        icon: ICON.home,     label: 'Home',      key: 'home' },
      { href: 'troubleshoot.html', icon: ICON.tool,     label: 'Solutions', key: 'troubleshoot' },
      { href: 'database.html',     icon: ICON.database, label: 'Database',  key: 'database' },
      { href: 'favorites.html',    icon: ICON.star,     label: 'Favorites', key: 'favorites' },
      { href: 'settings.html',     icon: ICON.settings, label: 'Settings',  key: 'settings' }
    ];
    return '<nav class="bottom-nav">' +
      items.map(i =>
        '<a href="' + i.href + '" class="bottom-nav__item ' + (i.key === active ? 'is-active' : '') + '">' +
          i.icon +
          '<span>' + i.label + '</span>' +
        '</a>'
      ).join('') +
    '</nav>';
  }

  const FILTERS = ['All', 'Prize', 'Dance', 'Gold Fish', 'Future Field', 'Other'];
  function matchFilter(machine, filter) {
    if (!filter || filter === 'All') return true;
    const hay = (machine.name + ' ' + machine.code).toLowerCase();
    return hay.includes(filter.toLowerCase());
  }

  return {
    toast, copy, normalize, tokenize, search, highlight, escapeHtml, parseMachineCode,
    loadData, saveData, clearData,
    getHistory, pushHistory, clearHistory, removeHistory,
    getFavorites, isFavorite, toggleFavorite, removeFavorite,
    debounce, ICON, header, backHeader, bottomNav, FILTERS, matchFilter
  };
})();

// ---------- Android Back Button Fix ----------
document.addEventListener('DOMContentLoaded', () => {
  if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.App) {
    const { App } = window.Capacitor.Plugins;
    let lastBackTime = 0;
    App.addListener('backButton', ({ canGoBack }) => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        const now = Date.now();
        if (now - lastBackTime < 2000) {
          if (App.exitApp) App.exitApp();
        } else {
          lastBackTime = now;
          const t = document.createElement('div');
          t.innerText = 'Press back again to exit';
          t.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#D32F2F;color:#fff;padding:8px 16px;border-radius:8px;font-size:14px;z-index:9999;';
          document.body.appendChild(t);
          setTimeout(() => t.remove(), 2000);
        }
      }
    });
  }
});
