<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B0E14">
<title>History — MACHINE SEARCH</title>
<link rel="stylesheet" href="brand.css">
<link rel="stylesheet" href="components.css">
<link rel="stylesheet" href="bg.css">
<link rel="stylesheet" href="styles.css">


</head>
<body>
<div id="app"></div>
<script src="app.js?v=1005"></script>
<script>
(function() {
  const app = document.getElementById('app');
  app.innerHTML = MS.backHeader('Search History') + `
    <main class="container" style="padding-top: var(--sp-4)">
      <div id="list"></div>
    </main>
  ` + MS.bottomNav('search');

  function render() {
    const list = document.getElementById('list');
    const hist = MS.getHistory();

    if (hist.length === 0) {
      list.innerHTML = `<div class="state">
        <div class="state__icon">${MS.ICON.clock}</div>
        <div class="state__title">No search history</div>
        <div class="state__subtitle">Your recent searches will appear here.</div>
      </div>`;
      return;
    }

    list.innerHTML = hist.map(q => `
      <div class="db-list-item" style="margin-bottom:8px" onclick="location.href='search.html?q=${encodeURIComponent(q)}'">
        <div class="db-list-item__icon" style="background:var(--surface-2);color:var(--text-secondary)">
          ${MS.ICON.clock}
        </div>
        <div class="db-list-item__body">
          <div class="db-list-item__name" style="margin-top:6px">${MS.escapeHtml(q)}</div>
        </div>
        <button class="icon-btn" onclick="event.stopPropagation(); removeHist('${MS.escapeHtml(q)}')" style="color:var(--text-muted)">
          ${MS.ICON.close}
        </button>
      </div>
    `).join('');
  }

  window.removeHist = function(q) {
    MS.removeHistory(q);
    render();
  };

  render();
})();
</script>
</body>
</html>
